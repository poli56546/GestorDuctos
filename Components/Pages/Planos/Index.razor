@page "/planos"
@rendermode InteractiveServer
@using GestorDuctos.Models
@using GestorDuctos.Services
@inject PlanoService PlanoService

<div class="container-fluid py-4 px-lg-4">
    <!-- Encabezado del Módulo -->
    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-8">
            <div class="p-4 panel-formal rounded-4 border-start border-success border-5"
                 style="background-color: rgba(255,255,255,0.02);">
                <h2 class="fw-bold mb-1 text-white">Listado Maestro de Planos</h2>
                <p class="text-muted mb-0">Control de Ingeniería Básica, Anexos y Trazabilidad As-Built</p>
            </div>
        </div>
        
        <!-- Solo el Administrador puede ver el botón de registrar nuevos planos -->
        <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
            <AuthorizeView Roles="Administrador">
                <Authorized>
                    <a href="planos/nuevo" class="btn btn-success rounded-pill px-4 shadow-sm fw-semibold text-white">
                        <i class="bi bi-plus-lg me-1"></i> Registrar / Nueva Versión
                    </a>
                </Authorized>
                <NotAuthorized>
                    <span class="text-muted small fst-italic">Modo lectura (Inicia sesión como Administrador)</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- Contenedor / Tarjeta Estilizada -->
    <div class="card panel-formal rounded-4 border-0 shadow-lg"
         style="background-color: rgba(20, 24, 33, 0.7); backdrop-filter: blur(10px);">
        <div class="card-body p-0">
            @if (planos == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="text-muted mt-2">Cargando listado maestro...</p>
                </div>
            }
            else if (!planos.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted fs-5 mb-1">No hay planos registrados en el sistema todavía.</p>
                    <p class="text-muted small">Utiliza el botón superior para dar de alta el primer plano.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-borderless align-middle mb-0"
                           style="background-color: transparent;">
                        <thead style="border-bottom: 1px solid rgba(255,255,255,0.08); background-color: rgba(0,0,0,0.2);">
                            <tr>
                                <th class="text-muted fw-normal text-uppercase py-3 ps-4"
                                    style="font-size: 0.75rem; letter-spacing: 1px;">Código</th>
                                <th class="text-muted fw-normal text-uppercase py-3"
                                    style="font-size: 0.75rem; letter-spacing: 1px;">Nombre del Plano</th>
                                <th class="text-muted fw-normal text-uppercase py-3"
                                    style="font-size: 0.75rem; letter-spacing: 1px;">Proyecto</th>
                                <th class="text-muted fw-normal text-uppercase py-3"
                                    style="font-size: 0.75rem; letter-spacing: 1px;">Disciplina</th>
                                <th class="text-muted fw-normal text-uppercase py-3"
                                    style="font-size: 0.75rem; letter-spacing: 1px;">Versión</th>
                                <th class="text-muted fw-normal text-uppercase py-3"
                                    style="font-size: 0.75rem; letter-spacing: 1px;">Autorización / Modificación</th>
                                <th class="text-muted fw-normal text-uppercase py-3"
                                    style="font-size: 0.75rem; letter-spacing: 1px;">Estado</th>
                                <th class="text-muted fw-normal text-uppercase py-3 text-center pe-4"
                                    style="font-size: 0.75rem; letter-spacing: 1px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in planos)
                            {
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.03);"
                                    class="@(p.EsVigente ? "" : "opacity-50")">
                                    <!-- 1. Código -->
                                    <td class="ps-4 py-3">
                                        <span
                                            class="badge badge-dark-success rounded-pill border border-success border-opacity-25 px-3 py-2 fw-semibold">
                                            @p.CodigoPlano
                                        </span>
                                    </td>
                                    
                                    <!-- 2. Nombre -->
                                    <td class="text-light fw-semibold">@p.Nombre</td>
                                    
                                    <!-- 3. Proyecto -->
                                    <td class="text-muted">@(p.ProyectoRelacionado != null ? p.ProyectoRelacionado.Clave :
                                                                        "General")</td>
                                    
                                        <!-- 4. Disciplina -->
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-25 text-light px-2 py-1">
                                                @p.Disciplina
                                            </span>
                                        </td>
                                    
                                        <!-- 5. Versión -->
                                        <td>
                                            <span class="badge bg-dark border border-secondary border-opacity-25 px-2 py-1">
                                                @p.Version
                                            </span>
                                        </td>
                                    
                                        <!-- 6. Autorización -->
                                        <td><small class="text-muted">@(string.IsNullOrEmpty(p.AutorizacionModificacion) ? "N/A" :
                                                                                p.AutorizacionModificacion)</small></td>
                                    
                                            <!-- 7. Estado -->
                                            <td>
                                                @if (p.EsAsBuilt)
                                                {
                                                    <span
                                                        class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1 fw-bold">
                                                        AS-BUILT
                                                    </span>
                                                }
                                                else if (p.EsVigente)
                                                {
                                                    <span
                                                        class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1 fw-bold">
                                                        Vigente
                                                    </span>
                                                }
                                                else
                                                {
                                                    <!-- CAMBIADO DE Obsoleto A Finalizado -->
                                                    <span
                                                        class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-1">
                                                        Finalizado
                                                    </span>
                                                }
                                            </td>
                                    
                                            <!-- 8. Acciones -->
                                            <td class="text-center pe-4">
                                                <div class="d-flex justify-content-center align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(p.RutaArchivo))
                                                    {
                                                        <a href="@p.RutaArchivo" target="_blank"
                                                           class="btn btn-sm btn-outline-success px-2 py-1 rounded-pill"
                                                           title="Ver o descargar documento">
                                                            <i class="bi bi-file-earmark-arrow-down me-1"></i> Ver Archivo
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small fst-italic">Sin archivo</span>
                                                    }

                                                    <a href="/planos/historial/@p.Id"
                                                       class="btn btn-sm btn-info rounded-pill px-3 py-1">
                                                        <i class="bi bi-search me-1"></i> Historial
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

@code {
    private List<Plano>? planos;

    protected override async Task OnInitializedAsync()
    {
        await CargarPlanos();
    }

    private async Task CargarPlanos()
    {
        planos = await PlanoService.ObtenerPlanosAsync();
    }
}