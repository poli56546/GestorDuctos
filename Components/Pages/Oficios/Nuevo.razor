@page "/oficios/nuevo"
@rendermode InteractiveServer
@using GestorDuctos.Models
@using GestorDuctos.Services
@inject OficioService OficioService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment WebHostEnvironment

<CascadingAuthenticationState>
    <div class="container-fluid py-4 px-lg-4" style="max-width: 800px;">
        <div class="row mb-4">
            <div class="col-12">
                <div class="p-4 panel-formal rounded-4 border-start border-info border-5" style="background-color: rgba(255,255,255,0.02);">
                    <h2 class="fw-bold mb-1 text-white">Registrar Nuevo Oficio</h2>
                    <p class="text-muted mb-0">Control documental, seguimiento y soporte de archivos adjuntos.</p>
                </div>
            </div>
        </div>

        <div class="card panel-formal rounded-4 border-0 shadow-lg" style="background-color: rgba(20, 24, 33, 0.7); backdrop-filter: blur(10px);">
            <div class="card-body p-4 p-md-5">
                
                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger rounded-3 small mb-4">
                        <strong>Atención:</strong> @mensajeError
                    </div>
                }

                <div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-light fw-semibold small text-uppercase" style="letter-spacing: 1px;">Folio *</label>
                            <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2" 
                                   @bind="nuevoOficio.Folio" placeholder="Ej. OFI-2026-002" />
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-light fw-semibold small text-uppercase" style="letter-spacing: 1px;">Tipo de Oficio</label>
                            <select class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2" @bind="nuevoOficio.TipoOficio">
                                <option value="Oficio de la empresa">Oficio de la empresa</option>
                                <option value="Seguimiento de oficio de PEMEX">Seguimiento de oficio de PEMEX</option>
                            </select>
                        </div>
                    </div>

                    <!-- NUEVO CAMPO: Oficio de solicitud No. -->
                    <div class="mb-4">
                        <label class="form-label text-light fw-semibold small text-uppercase" style="letter-spacing: 1px;">Oficio de solicitud No.</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2" 
                               @bind="nuevoOficio.OficioSolicitudNo" placeholder="Ej. PEMEX-SOL-2026-88" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-light fw-semibold small text-uppercase" style="letter-spacing: 1px;">Dirigido o en Atención</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2" 
                               @bind="nuevoOficio.DirigidoAtencion" placeholder="Ej. Ing. Roberto Mendoza / Departamento Técnico" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-light fw-semibold small text-uppercase" style="letter-spacing: 1px;">Asunto *</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2" 
                               @bind="nuevoOficio.Asunto" placeholder="Descripción breve del documento" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-light fw-semibold small text-uppercase" style="letter-spacing: 1px;">Remitente</label>
                            <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2" 
                                   @bind="nuevoOficio.Remitente" placeholder="Quién emite el oficio" />
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-light fw-semibold small text-uppercase" style="letter-spacing: 1px;">Fecha de la Solicitud</label>
                            <input type="date" class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2" 
                                   @bind="nuevoOficio.FechaSolicitud" />
                        </div>
                    </div>

                    <!-- CARGA DE ARCHIVO ADJUNTO -->
                    <div class="mb-4">
                        <label class="form-label text-light fw-semibold small text-uppercase" style="letter-spacing: 1px;">Documento Adjunto (PDF / Imagen)</label>
                        <InputFile OnChange="ManejarSeleccionArchivo" class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2" />
                        @if (!string.IsNullOrEmpty(nombreArchivo))
                        {
                            <small class="text-success mt-2 d-block">✔ Archivo seleccionado: @nombreArchivo</small>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top border-secondary border-opacity-10">
                        <a href="oficios" class="btn btn-outline-secondary rounded-pill px-4">
                            ⬅ Volver al Listado
                        </a>
                        <button type="button" @onclick="GuardarOficio" class="btn btn-info rounded-pill px-5 shadow-sm fw-semibold text-dark">
                            Guardar Oficio y Archivo
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</CascadingAuthenticationState>

@code {
    private Oficio nuevoOficio = new();
    private string? mensajeError;
    private IBrowserFile? archivoSeleccionado;
    private string? nombreArchivo;

    private void ManejarSeleccionArchivo(InputFileChangeEventArgs e)
    {
        archivoSeleccionado = e.File;
        nombreArchivo = archivoSeleccionado?.Name;
    }

    private async Task GuardarOficio()
    {
        try
        {
            mensajeError = null;

            if (string.IsNullOrWhiteSpace(nuevoOficio.Folio) || string.IsNullOrWhiteSpace(nuevoOficio.Asunto))
            {
                mensajeError = "El Folio y el Asunto son obligatorios.";
                return;
            }

            if (archivoSeleccionado != null)
            {
                string webRootPath = WebHostEnvironment.WebRootPath ?? Path.Combine(Directory.GetCurrentDirectory(), "wwwroot");
                string uploadsFolder = Path.Combine(webRootPath, "uploads", "oficios");

                if (!Directory.Exists(uploadsFolder))
                {
                    Directory.CreateDirectory(uploadsFolder);
                }

                string uniqueFileName = $"{Guid.NewGuid()}_{archivoSeleccionado.Name}";
                string filePath = Path.Combine(uploadsFolder, uniqueFileName);

                using (var stream = new FileStream(filePath, FileMode.Create))
                {
                    await archivoSeleccionado.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024).CopyToAsync(stream);
                }

                nuevoOficio.RutaArchivo = $"/uploads/oficios/{uniqueFileName}";
                nuevoOficio.FechaSubida = DateTime.Now;
                nuevoOficio.TamanoBytes = archivoSeleccionado.Size;
            }

            await OficioService.GuardarOficioAsync(nuevoOficio);
            NavigationManager.NavigateTo("oficios");
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar el oficio: {ex.Message}";
        }
    }
}