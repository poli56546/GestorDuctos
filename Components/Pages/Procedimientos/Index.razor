@page "/procedimientos"
@rendermode InteractiveServer
@using GestorDuctos.Models
@using GestorDuctos.Services
@inject ProcedimientoService ProcedimientoService

<CascadingAuthenticationState>
    <div class="container-fluid py-4 px-lg-4">
        <!-- Encabezado del Módulo -->
        <div class="row mb-4 align-items-center">
            <div class="col-12 col-md-8">
                <div class="p-4 panel-formal rounded-4 border-start border-warning border-5" style="background-color: rgba(255,255,255,0.02);">
                    <h2 class="fw-bold mb-1 text-white">Listado Maestro de Procedimientos (SGC)</h2>
                    <p class="text-muted mb-0">Normativa técnica, manuales y procedimientos operativos estandarizados.</p>
                </div>
            </div>
            
            <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
                <AuthorizeView Roles="Administrador">
                    <Authorized Context="authContext">
                        <a href="procedimientos/nuevo" class="btn btn-warning rounded-pill px-4 shadow-sm fw-semibold text-dark">
                            <i class="bi bi-plus-lg me-1"></i> ➕ Registrar Nuevo Procedimiento
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <span class="text-muted small fst-italic">Modo lectura (Inicia sesión como Administrador)</span>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <!-- Contenedor / Tarjeta Estilizada -->
        <div class="card panel-formal rounded-4 border-0 shadow-lg" style="background-color: rgba(20, 24, 33, 0.7); backdrop-filter: blur(10px);">
            <div class="card-body p-0">
                @if (procedimientos == null)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-warning" role="status"></div>
                        <p class="text-muted mt-2">Cargando procedimientos...</p>
                    </div>
                }
                else if (!procedimientos.Any())
                {
                    <div class="text-center py-5">
                        <p class="text-muted fs-5 mb-1">No hay procedimientos registrados en el SGC todavía.</p>
                        <p class="text-muted small">Utiliza el botón superior para dar de alta el primer documento normativo.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-borderless align-middle mb-0" style="background-color: transparent;">
                            <thead style="border-bottom: 1px solid rgba(255,255,255,0.08); background-color: rgba(0,0,0,0.2);">
                                <tr>
                                    <th class="text-muted fw-normal text-uppercase py-3 ps-4" style="font-size: 0.75rem; letter-spacing: 1px;">Código</th>
                                    <th class="text-muted fw-normal text-uppercase py-3" style="font-size: 0.75rem; letter-spacing: 1px;">Título del Procedimiento</th>
                                    <th class="text-muted fw-normal text-uppercase py-3" style="font-size: 0.75rem; letter-spacing: 1px;">Versión</th>
                                    <th class="text-muted fw-normal text-uppercase py-3" style="font-size: 0.75rem; letter-spacing: 1px;">Área / Proceso</th>
                                    <th class="text-muted fw-normal text-uppercase py-3 text-center pe-4" style="font-size: 0.75rem; letter-spacing: 1px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var proc in procedimientos)
                                {
                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.03);">
                                        <td class="ps-4 py-3">
                                            <span class="badge badge-dark-warning rounded-pill border border-warning border-opacity-25 px-3 py-2 fw-semibold" style="letter-spacing: 1px; font-family: monospace; font-size: 0.9rem;">
                                                @proc.Codigo
                                            </span>
                                        </td>
                                        <td class="text-light fw-semibold">@proc.Titulo</td>
                                        <td>
                                            <span class="badge bg-dark border border-secondary border-opacity-25 px-2 py-1">
                                                @proc.Version
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-25 text-light px-2 py-1">
                                                @proc.Area
                                            </span>
                                        </td>
                                        <td class="text-center pe-4">
                                            <a href="/procedimientos/@proc.Id" class="btn btn-sm btn-outline-warning px-3 py-1 fw-semibold rounded-pill text-light">
                                                Ver Historial
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</CascadingAuthenticationState>

@code {
    private List<Procedimiento>? procedimientos;

    protected override async Task OnInitializedAsync()
    {
        procedimientos = await ProcedimientoService.ObtenerProcedimientosAsync();
    }
}