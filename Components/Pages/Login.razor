@page "/Account/Login"
@page "/login"
@page "/Identity/Account/Login"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Iniciar Sesión - GestorDuctos</PageTitle>

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center py-5" style="background-color: #0b0f19;">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-8 col-lg-5 col-xl-4">

            <!-- Encabezado de Marca / Logotipo -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-circle p-3 mb-3 shadow-lg" style="width: 70px; height: 70px;">
                    <i class="bi bi-shield-lock-fill text-primary fs-3"></i>
                </div>
                <h2 class="fw-bold text-white tracking-wide">Gestor<span class="text-primary">Ductos</span></h2>
                <p class="text-muted small">Plataforma Integral de Ingeniería, Obras y Control SGC</p>
            </div>

            <!-- Tarjeta Principal Traslúcida -->
            <div class="card border-0 rounded-4 shadow-lg" style="background-color: rgba(20, 24, 33, 0.75); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="card-body p-4 p-md-5">

                    <h4 class="text-white fw-bold mb-4 text-center">Iniciar Sesión</h4>

                    @if (!string.IsNullOrEmpty(Error))
                    {
                        <div class="alert alert-danger text-center small py-2 rounded-3">
                            @(Error == "InvalidCredentials" ? "Error: Intento de inicio de sesión no válido. Verifique sus credenciales." : Error)
                        </div>
                    }

                    <form method="post" action="/api/auth/login">
                        <div class="mb-3">
                            <label class="form-label text-light small fw-semibold text-uppercase" style="letter-spacing: 1px;">Correo Electrónico</label>
                            <input type="email" name="email" required class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-light small fw-semibold text-uppercase" style="letter-spacing: 1px;">Contraseña</label>
                            <input type="password" name="password" required class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                        </div>

                        <div class="mb-4 form-check">
                            <input type="checkbox" name="rememberMe" value="true" class="form-check-input bg-dark border-secondary" id="rememberMeCheck" />
                            <label class="form-check-label text-muted small" for="rememberMeCheck">
                                Recordar en este equipo
                            </label>
                        </div>

                        <button type="submit" class="w-100 btn btn-primary rounded-pill py-3 fw-semibold shadow-sm text-white">
                            Acceder al Sistema
                        </button>
                    </form>

                    <!-- Enlace de registro para nuevos trabajadores -->
                    <div class="text-center mt-4 border-top border-secondary border-opacity-25 pt-4">
                        <p class="mb-0 text-muted small">
                            ¿Personal nuevo? <a href="registro" class="text-info text-decoration-none fw-bold">Crear cuenta de trabajador</a>
                        </p>
                    </div>

                </div>
            </div>

            <!-- Pie de página discreto -->
            <div class="text-center mt-4">
                <p class="text-muted small mb-0">Sistema de Acceso Restringido • Autorizado solo para personal operativo y gerencias.</p>
            </div>

        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}