@page "/proyectos/nuevo"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@using GestorDuctos.Models
@using GestorDuctos.Services
@inject ProyectoService ProyectoService
@inject NavigationManager NavigationManager

<CascadingAuthenticationState>
    <div class="container-fluid py-4 px-lg-4" style="max-width: 800px;">
        <div class="row mb-4">
            <div class="col-12">
                <div class="p-4 panel-formal rounded-4 border-start border-primary border-5"
                     style="background-color: rgba(255,255,255,0.02);">
                    <h2 class="fw-bold mb-1 text-white">Registrar Nuevo Proyecto</h2>
                    <p class="text-muted mb-0">Alta de nueva obra, asignación de contrato y especificaciones generales.</p>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger rounded-3 small mb-4">
                <strong>Atención:</strong> @errorMessage
            </div>
        }

        <div class="card panel-formal rounded-4 border-0 shadow-lg"
             style="background-color: rgba(20, 24, 33, 0.7); backdrop-filter: blur(10px);">
            <div class="card-body p-4 p-md-5">

                <EditForm Model="nuevoProyecto" OnValidSubmit="GuardarProyecto" FormName="NuevoProyectoForm">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label class="form-label text-light fw-semibold small text-uppercase"
                               style="letter-spacing: 1px;">Nombre del Proyecto *</label>
                        <InputText
                            class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2"
                            @bind-Value="nuevoProyecto.Nombre" placeholder="Ej. Ducto Regional Sur" />
                        <ValidationMessage For="() => nuevoProyecto.Nombre" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-light fw-semibold small text-uppercase"
                               style="letter-spacing: 1px;">Clave de la Obra *</label>
                        <InputText
                            class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2"
                            @bind-Value="nuevoProyecto.Clave" placeholder="Ej. OBRA-001" />
                        <ValidationMessage For="() => nuevoProyecto.Clave" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-light fw-semibold small text-uppercase"
                               style="letter-spacing: 1px;">Contrato del Cliente</label>
                        <InputText
                            class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2"
                            @bind-Value="nuevoProyecto.ContratoCliente" placeholder="Ej. C-2026-001" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-light fw-semibold small text-uppercase"
                               style="letter-spacing: 1px;">Descripción General</label>
                        <InputTextArea
                            class="form-control bg-dark text-light border-secondary border-opacity-25 rounded-3 px-3 py-2"
                            rows="4" @bind-Value="nuevoProyecto.Descripcion"
                            placeholder="Detalles generales de la obra, gerencia o tramo..." />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top border-secondary border-opacity-10">
                        <a href="proyectos" class="btn btn-outline-secondary rounded-pill px-4">
                            Volver al Listado
                        </a>
                        <button type="submit" disabled="@guardando"
                                class="btn btn-primary rounded-pill px-5 shadow-sm fw-semibold text-white">
                            @(guardando ? "Guardando..." : "Guardar Proyecto")
                        </button>
                    </div>
                </EditForm>

            </div>
        </div>
    </div>
</CascadingAuthenticationState>

@code {
    private Proyecto nuevoProyecto { get; set; } = new();
    private string? errorMessage;
    private bool guardando = false;

    protected override void OnInitialized()
    {
        nuevoProyecto ??= new();
    }

    private async Task GuardarProyecto()
    {
        if (guardando) return;
        guardando = true;

        try
        {
            errorMessage = null;

            if (string.IsNullOrWhiteSpace(nuevoProyecto.Nombre) || string.IsNullOrWhiteSpace(nuevoProyecto.Clave))
            {
                errorMessage = "El nombre y la clave del proyecto son obligatorios.";
                return;
            }

            if (nuevoProyecto.FechaCreacion == default)
            {
                nuevoProyecto.FechaCreacion = DateTime.UtcNow;
            }
            else if (nuevoProyecto.FechaCreacion.Kind != DateTimeKind.Utc)
            {
                nuevoProyecto.FechaCreacion = nuevoProyecto.FechaCreacion.ToUniversalTime();
            }

            await ProyectoService.GuardarProyectoAsync(nuevoProyecto);
            NavigationManager.NavigateTo("proyectos");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar el proyecto: {ex.InnerException?.Message ?? ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }
}